# ==== App ====
APP_ENV=development
SECRET_KEY=CONFIGURATION_PENDING_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# ==== Database ====
DATABASE_URL=postgresql+psycopg2://ac_user:ac_password@localhost:5432/smart_ac_db

# ==== Azure OpenAI (chat / classification) ====
AZURE_OPENAI_ENDPOINT=CONFIGURATION_PENDING
AZURE_OPENAI_API_KEY=CONFIGURATION_PENDING
AZURE_OPENAI_API_VERSION=CONFIGURATION_PENDING
AZURE_OPENAI_DEPLOYMENT=CONFIGURATION_PENDING

# ==== Azure OpenAI Embeddings ====
AZURE_OPENAI_EMBEDDING_ENDPOINT=CONFIGURATION_PENDING
AZURE_OPENAI_EMBEDDING_API_KEY=CONFIGURATION_PENDING
AZURE_OPENAI_EMBEDDING_API_VERSION=CONFIGURATION_PENDING
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=CONFIGURATION_PENDING

# ==== Gemini Chatbot ====
GEMINI_API_KEY=CONFIGURATION_PENDING
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# ==== AI thresholds ====
AI_MIN_CONFIDENCE=0.55
PREDICTIVE_HEALTH_THRESHOLD=40
PREDICTIVE_ANOMALY_THRESHOLD=0.7

# ==== File storage (local abstraction, swappable later) ====
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
